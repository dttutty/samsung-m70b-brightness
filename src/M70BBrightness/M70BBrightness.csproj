<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AssemblyName>M70B亮度调节</AssemblyName>
    <ApplicationIcon>assets\m70b-tv.ico</ApplicationIcon>
    <Version>0.5.6</Version>
    <AssemblyTitle>Samsung Display Control</AssemblyTitle>
    <Authors>dttutty</Authors>
    <Description>Windows tray brightness controller for Samsung Tizen displays</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="assets\m70b-tv.png" />
    <None Include="assets\m70b-tv.ico" />
    <None Include="assets\m70b-tv.svg" />
  </ItemGroup>
</Project>
